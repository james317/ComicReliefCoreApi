<Project Sdk="Microsoft.NET.Sdk">

  <!--
    "comic-relief api" (see docs/BACKLOG.md's naming section): backend operations only -
    DCBS interaction and the data layer. No business logic/decision-making belongs here;
    that lives in ComicReliefCoreApi.App, which references this project.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
  </ItemGroup>

</Project>
